{
  "name": "Saul's Sunday School",
  "short_name": "Sunday School",
  "description": "Free, ad-free Bible learning for kids ages 3–12 from Saul's Podship: narrated stories, quizzes, games, memory verses, prayer journal and parent dashboard. Works offline.",
  "id": "com.saulspodship.sundaychool",
  "start_url": "./?utm_source=pwa&utm_medium=install",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait-primary",
  "background_color": "#fdf6e9",
  "theme_color": "#f2a13b",
  "lang": "en",
  "dir": "auto",
  "categories": [
    "education",
    "kids",
    "religion",
    "lifestyle"
  ],
